rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bloqueo total desde el navegador/cliente: solo el servidor (Admin SDK) lee y escribe estas colecciones.
    match /{document=**} {
      allow read, write: if false;
    }

    match /compras/{compraId} {
      allow read, write: if false;
    }

    match /uso_diario/{usoId} {
      allow read, write: if false;
    }

    match /sesiones_chat/{sesionId} {
      allow read, write: if false;
    }
  }
}
